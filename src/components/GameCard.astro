---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  game: CollectionEntry<'games'>;
  featured?: boolean;
}

const { game, featured = false } = Astro.props;
const { data, id } = game;
const gameUrl = `/games/${id}`;
---

<article
  class:list={[
    'card card-hover group flex flex-col p-6 sm:p-8 relative overflow-hidden',
    featured ? 'md:col-span-2 lg:col-span-2' : '',
  ]}
>
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5 pb-6 border-b border-[var(--hairline)]">
    <!-- Icon & Title header -->
    <div class="flex items-center gap-4 sm:gap-5">
      <div class="relative shrink-0">
        <Image
          src={data.icon}
          alt={data.iconAlt}
          width={72}
          height={72}
          class="w-16 h-16 sm:w-18 sm:h-18 rounded-2xl border border-[var(--hairline-strong)] shadow-lg shadow-black/40 object-cover transition-transform duration-300 group-hover:scale-105"
        />
        <span class="absolute -bottom-1 -right-1 flex h-4 w-4">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--color-teal)] opacity-60"></span>
          <span class="relative inline-flex rounded-full h-4 w-4 bg-[var(--color-teal)] border-2 border-[var(--color-plum)]"></span>
        </span>
      </div>

      <div>
        <div class="flex flex-wrap items-center gap-2 mb-1">
          <span class="chip-gold text-[0.7rem] uppercase tracking-wider px-2.5 py-0.5 rounded-full border">
            {data.genre}
          </span>
          {data.featured && (
            <span class="text-[0.68rem] tracking-wider uppercase text-[var(--color-orchid)] flex items-center gap-1 font-medium">
              <Icon name="sparkle" size={12} />
              Featured
            </span>
          )}
        </div>
        <h3 class="text-2xl sm:text-3xl font-normal text-[var(--color-pearl)] group-hover:text-[var(--color-gold)] transition-colors">
          <a href={gameUrl} class="focus:outline-none">
            <span class="absolute inset-0" aria-hidden="true" />
            {data.title}
          </a>
        </h3>
      </div>
    </div>

    <!-- Quick action / store badge indicator -->
    <div class="shrink-0 self-start sm:self-center">
      <span class="inline-flex items-center gap-1.5 text-xs text-[var(--color-gold)] font-medium group-hover:translate-x-1 transition-transform">
        <span>Explore Game</span>
        <Icon name="arrowRight" size={14} />
      </span>
    </div>
  </div>

  <!-- Tagline & summary -->
  <div class="py-5 space-y-2 flex-1">
    <p class="text-base text-[var(--color-pearl)] font-medium">
      {data.tagline}
    </p>
    <p class="text-sm text-[var(--color-mist)] leading-relaxed line-clamp-3">
      {data.summary}
    </p>
  </div>

  <!-- Meta footer chips -->
  <div class="pt-4 border-t border-[var(--hairline)] flex flex-wrap items-center justify-between gap-3 text-xs text-[var(--color-mist)]">
    <div class="flex flex-wrap items-center gap-2">
      {
        data.platforms.map((p) => (
          <span class="chip chip-muted text-[0.7rem] py-0.5 px-2">
            <Icon name={p === 'Android' ? 'android' : 'gamepad'} size={12} />
            {p}
          </span>
        ))
      }
      <span class="chip chip-muted text-[0.7rem] py-0.5 px-2">
        {data.contentRating}
      </span>
      {data.containsAds && (
        <span class="chip chip-muted text-[0.7rem] py-0.5 px-2">
          Contains ads
        </span>
      )}
    </div>

    <div class="flex items-center gap-2 text-[var(--color-pearl)] font-medium">
      <span>{data.price}</span>
    </div>
  </div>
</article>
